        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Location.Name)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Location.Name)
        </dd>
    </dl>*@
    
    <form method="post">
        <input type="hidden" asp-for="Location.Id" />
        <input type="submit" value="Delete" class="btn btn-danger btn-lg" /> 
        <a class="btn btn-primary btn-lg" asp-page="./Locations">Cancel</a>
    </form>
</div>
