@page
@model HomeStuff.Pages.LocationDeleteModel

@{
    ViewData["Title"] = "Delete Location";
}

<h1>Delete @Html.DisplayFor(model => model.Location.Name)?</h1>
<hr />
@if (Model.Items.Count>0)
{
    <p>Deleting this location also deletes all items in it (currently <a title="Show items in this location" href="./items?l=@Model.Location.Id">@Model.Items.Count items</a> ). If you'd like to retain them, please move them to another location first.</p>
}
<p> Are you sure you want to delete this location?</p>
<div>    
    <form method="post">
        <input type="hidden" asp-for="Location.Id" />
        <input type="submit" value="Delete" class="btn btn-danger btn-lg" /> 
        <a class="btn btn-primary btn-lg" asp-page="./Locations">Cancel</a>
    </form>
</div>
