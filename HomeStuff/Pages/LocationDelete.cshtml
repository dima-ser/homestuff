@page
@model HomeStuff.Pages.LocationDeleteModel

@{
    ViewData["Title"] = "Delete Location";
}

<h1>Delete @Html.DisplayFor(model => model.Location.Name)?</h1>
<hr />
@if (Model.Items.Count>0)
{
    <p>Deleting location also deletes all items in it (currently @Model.Items.Count items). If you'd like to retain them, please move them to another location first.</p>
}
<p> Are you sure you want to delete this location?</p>
<div>

