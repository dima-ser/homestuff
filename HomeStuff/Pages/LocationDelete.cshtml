@page
@model HomeStuff.Pages.LocationDeleteModel

@{
    ViewData["Title"] = "Delete Location";
}

<h1>@ViewData["Title"]</h1>

<h3>Are you sure you want to delete this location?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Location.Name)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Location.Name)
        </dd>
    </dl>
    
    <form method="post">
        <input type="hidden" asp-for="Location.Id" />
        <input type="submit" value="Delete" class="btn btn-danger btn-lg" /> |
        <a asp-page="./Locations">Back to List</a>
    </form>
</div>
