@page
@model HomeStuff.Pages.SetDeleteModel

@{
    ViewData["Title"] = "Delete Set";
}

<h1>Delete @Html.DisplayFor(model => model.ItemSet.Name)?</h1>
<hr />
@if (Model.Items.Count>0)
{
    <p>All <a title="Show items in this set" href="./items?set=@Model.ItemSet.Id">items currently in this set</a> will be unlinked from it. Deleting the set won't delete the items.</p>
}
<p> Are you sure you want to delete this set?</p>
<div>    
    <form method="post">
        <input type="hidden" asp-for="ItemSet.Id" />
        <input type="submit" value="Delete" class="btn btn-danger btn-lg" /> 
        <a class="btn btn-primary btn-lg" asp-page="./Sets">Cancel</a>
    </form>
</div>
