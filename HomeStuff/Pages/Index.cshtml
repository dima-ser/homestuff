@page
@model HomeStuff.Pages.IndexModel
@{
    ViewData["Title"] = "Home";
}
<h1>Home</h1>
<hr />
@if (Model.RecentItems.Count > 0)
{
    <form action="/items">
        <div class="row no-gutters mb-3">
            <div class="col input-group">
                <input class="form-control" type="search" placeholder="Search items" name="q">
                <button class="btn btn-primary" type="submit">Search</button>
            </div>
        </div>
    </form>
}
<h2>Recently Updated Items</h2>

@if (Model.RecentItems.Count > 0)
{
    <div class="row">
        @foreach (var item in Model.RecentItems)
        {
            <div class="col-md-4 mb-2">
                <div class="card h-100 card-hover">
                    <h5 class="card-header bg-primary text-light">@(item.Name.Length > 50 ? item.Name.Substring(0, 50) + "..." : item.Name)</h5>
                    <div class="card-body border-primary">
                        <p class="card-text"> @(item.Description != null && item.Description.Length > 135 ? item.Description.Substring(0, 135) + "..." : item.Description)</p>
                        <span class="badge bg-dark align-bottom"> @item.Location!.FullName</span>
                        @if (item.PurchasePrice != null)
                        {
                            <span class="badge bg-success align-bottom">@Html.DisplayFor(model => item.PurchasePrice)</span>
                        }
                        @if (item.Status == Models.Item.ItemStatus.Missing)
                        {
                            <span class="badge bg-danger align-bottom">@Html.DisplayFor(model => item.Status)</span>
                        }
                        @if (item.Status == Models.Item.ItemStatus.Gone)
                        {
                            <span class="badge bg-warning align-bottom">@Html.DisplayFor(model => item.Status)</span>
                        }
                        <a asp-page="./Item" asp-route-id="@item.Id" class="stretched-link"></a>
                    </div>
                </div>
            </div>

        }
    </div>
    <div class="d-flex justify-content-center"><a class="btn btn-primary btn-lg" asp-page="Items">See All Items</a></div>
}
else
{
    <div class="row">
        <div class="col">
            <div class="alert alert-warning" role="alert">
                No items in the database. Add or import items to see something here.
            </div>
        </div>
    </div>
    <div class="d-flex justify-content-center"><a class="btn btn-primary btn-lg" asp-page="ItemNew">Add Item</a></div>
}




<h2>Upcoming Maintenance</h2>
<div class="row">
    @if (Model.UpcomingMaintenance.Count > 0)
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th scope="col">Item</th>
                        <th scope="col">Scheduled Date</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.UpcomingMaintenance[0].Description)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.UpcomingMaintenance[0].Completed)</th>
                        <th scope="col"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var maint in Model.UpcomingMaintenance)
                    {
                        <tr class="position-relative  @(maint.Date <= DateOnly.FromDateTime(DateTime.Now) ? "table-danger" : "")">
                            <th scope="row">@maint.Item!.Name</th>
                            <td>@maint.Date</td>
                            <td>@maint.Description</td>
                            <td>@(maint.Date <= DateOnly.FromDateTime(DateTime.Now) ? "Overdue" : "Scheduled")</td>
                            <td><a class="stretched-link" asp-page="./Maintenance" asp-route-itemid="@maint.ItemId"></a></td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="col">
            <div class="alert alert-success" role="alert">
                No maintenance in the next @IndexModel.UPCOMING_MAINTENANCE_DAYS days.
            </div>
        </div>
    }
</div>
<h2>Recently Completed Maintenance</h2>
<div class="row">
    @if (Model.CompletedMaintenance.Count > 0)
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th scope="col">Item</th>
                        <th scope="col">Completed Date</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.CompletedMaintenance[0].Description)</th>
                        <th scope="col"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var maint in Model.CompletedMaintenance)
                    {
                        <tr class="position-relative table-success">
                            <th scope="row">@maint.Item!.Name</th>
                            <td>@maint.Date</td>
                            <td>@maint.Description</td>
                            <td><a class="stretched-link" asp-page="./Maintenance" asp-route-itemid="@maint.ItemId"></a></td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="col">
            <div class="alert alert-success" role="alert">
                No maintenance completed the past @IndexModel.COMPLETED_MAINTENANCE_DAYS days.
            </div>
        </div>
    }
</div>
@if (Model.MissingItems.Count > 0)
{
    <h2>Missing Items</h2>
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th scope="col">Name</th>
                    <th scope="col">Last Known Location</th>
                    <th scope="col"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.MissingItems)
                {
                    <tr class="position-relative table-danger">
                        <th scope="row">@item.Name</th>
                        <td>@item.Location.FullName</td>
                        <td><a class="stretched-link" asp-page="./Item" asp-route-id="@item.Id"></a></td>
                    </tr>
                }

            </tbody>
        </table>
    </div>
}
<h2>Value Report (Active Items Only)</h2>
<div class="row">
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th scope="col">Total Value</th>
                    <th scope="col">@String.Format("{0:C}", Model.TotalValue) </th>
                    <th scope="col"></th>
                </tr>
            </thead>
            <tbody>
               
                @if (Model.ValueLocations.Count > 0)
                {
                    for (int i = 0; i < Model.ValueLocations.Count; i++)
                    {
                        <tr class="position-relative table-secondary">
                            <th scope="row">@if(Model.ValueLocations[i].ParentId != null)
                                {
                                    @Html.Raw("&nbsp;&nbsp;&nbsp;&nbsp;")
                                }
                                @Model.ValueLocations[i].Name</th>
                            <td>@String.Format("{0:C}", Model.ValueNumbers[i]) </td>
                              <td><a class="stretched-link" asp-page="./Items" asp-route-l="@Model.ValueLocations[i].Id"></a></td>  
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>