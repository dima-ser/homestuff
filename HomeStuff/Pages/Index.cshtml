@page
@model HomeStuff.Pages.IndexModel
@{
    ViewData["Title"] = "Home";
}
<h1>Home</h1>
<h2>Recently Updated Items</h2>
<div class="row">
    @if (Model.RecentItems.Count > 0)
    {
        @foreach (var item in Model.RecentItems)
        {
            <div class="col-md-4 mb-2">
                <div class="card h-100 card-hover">
                    <h5 class="card-header bg-primary text-light">@(item.Name.Length > 50 ? item.Name.Substring(0, 50) + "..." : item.Name)</h5>
                    <div class="card-body border-primary">
                        <p class="card-text"> @(item.Description != null && item.Description.Length > 135 ? item.Description.Substring(0, 135) + "..." : item.Description)</p>
                        <span class="badge bg-dark align-bottom">@item.Location!.Name</span>
                        @if (item.PurchasePrice != null)
                        {
                            <span class="badge bg-success align-bottom">@Html.DisplayFor(model => item.PurchasePrice)</span>
                        }
                        <a asp-page="./Item" asp-route-id="@item.Id" class="stretched-link"></a>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col">
            <div class="alert alert-warning" role="alert">
                No items in the database. Add or import items to see something here.
            </div>
        </div>
    }
</div>
<div class="d-flex justify-content-center"><a class="btn btn-primary btn-lg" href="/items">See All Items</a></div>
<h2>Overdue Maintenance</h2>
<div class="row">
    @if (Model.OverdueMaintenance.Count > 0)
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th scope="col">Item</th>
                        <th scope="col">Due Date</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.OverdueMaintenance[0].Description)</th>
                        <th scope="col"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var maint in Model.OverdueMaintenance)
                    {
                        <tr class="table-danger position-relative">
                            <th scope="row">@maint.Item!.Name</th>
                            <td>@maint.Date</td>
                            <td>@maint.Description</td>
                            <td><a class="stretched-link" asp-page="./Maintenance" asp-route-itemid="@maint.ItemId"></a></td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="col">
            <div class="alert alert-success" role="alert">
                No items are overdue for maintenance :)
            </div>
        </div>
    }
</div>
<h2>Upcoming Maintenance</h2>
<div class="row">
    @if (Model.UpcomingMaintenance.Count > 0)
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th scope="col">Item</th>
                        <th scope="col">Scheduled Date</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.OverdueMaintenance[0].Description)</th>
                        <th scope="col"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var maint in Model.UpcomingMaintenance)
                    {
                        <tr class="position-relative">
                            <th scope="row">@maint.Item!.Name</th>
                            <td>@maint.Date</td>
                            <td>@maint.Description</td>
                            <td><a class="stretched-link" asp-page="./Maintenance" asp-route-itemid="@maint.ItemId"></a></td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="col">
            <div class="alert alert-success" role="alert">
                No maintenance in the coming week.
            </div>
        </div>
    }
</div>