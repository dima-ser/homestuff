@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="row">
    @foreach (var item in Model.Items)
    {
        <div class="col-md-4 mb-2">
            <div class="card h-100 card-hover">
                <h5 class="card-header bg-primary text-light">@(item.Name.Length > 50 ? item.Name.Substring(0, 50) + "..." : item.Name)</h5>
                <div class="card-body border-primary">
                    <p class="card-text"> @(item.Description != null && item.Description.Length > 135 ? item.Description.Substring(0, 135) + "..." : item.Description)</p>
                    <a asp-page="./Item" asp-route-id="@item.Id" class="stretched-link"></a>
                </div>
            </div>
        </div>
    }
</div>
