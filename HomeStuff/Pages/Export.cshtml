@page
@model HomeStuff.Pages.ExportModel
@{
    ViewData["Title"] = "Export";
}
<h1>@ViewData["Title"]</h1>
<hr />
<div class="alert alert-warning" role="alert">
    This feature is limited and is not intended for data migration between Homestuff instances. Location hierarchy will be flattened. Will not export attachments.
    To migrate entire database, simply copy your database folder to the new instance.
</div>
<h3>Export Items</h3>
<div class="row">
    <div class="col">
        <form method="post">
            <input asp-for="@Model.ExportItems" type="hidden" value="true"  />
            <input type="submit" class="btn btn-primary btn-lg mt-3" value="Export Items" />
        </form>
    </div>
</div>
<br />
<hr />
<h3>Export Maintenance Log</h3>
<div class="row">
    <div class="col">
        <form method="post">
            <input asp-for="@Model.ExportMaintenance" type="hidden" value="true" />
            <div class="form-check">
                <input class="form-check-input" type="checkbox" asp-for="@Model.MaintCompletedOnly" checked>
                <label class="form-check-label" asp-for="@Model.MaintCompletedOnly">
                    Completed Maintenance Only
                </label>
            </div>
            <input type="submit" class="btn btn-primary btn-lg mt-3" value="Export Maintenace" />
        </form>
    </div>
</div>