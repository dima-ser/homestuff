@page
@model HomeStuff.Pages.ItemDeleteModel

@{
    ViewData["Title"] = "Delete Item";
}

<h1>Delete @Html.DisplayFor(model => model.Item.Name)?</h1>
<hr />
<p>Are you sure you want to delete this item?</p>
<div>
 
    <form method="post">
        <input type="hidden" asp-for="Item.Id" />
        <input type="submit" value="Delete" class="btn btn-danger btn-lg" /> 
        <a class="btn btn-primary btn-lg" asp-page="./Item" asp-route-id="@Model.Item?.Id">Cancel</a>
    </form>
</div>
