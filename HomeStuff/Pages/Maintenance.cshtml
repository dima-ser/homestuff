@page
@model HomeStuff.Pages.MaintenanceModel
@{
    
}
<h1>@Html.DisplayFor(model => model.Item.Name)</h1>
<hr />
<div class="row">
    <div class="col">
        <div class="btn-group mb-3" role="toolbar" aria-label="Item navigation">
            <a asp-page="./Item" asp-route-id="@Model.Item?.Id" class="btn btn-primary">Details</a>
            <a asp-page="./ItemEdit" asp-route-id="@Model.Item?.Id" class="btn btn-primary">Edit</a>
            <a href="#" class="btn btn-primary active" aria-current="page">Maintenance</a>
        </div>
    </div>
    <div class="col-auto float-end">
        <a asp-page="./ItemDelete" asp-route-id="@Model.Item?.Id" class="btn btn-danger">Delete</a>
    </div>
</div>
<form method="post" asp-page-handler="add">
    <input type="hidden" asp-for="NewMaintenance.ItemId" />
    <input type="hidden" asp-for="ItemId" />
    <div class="row">
        <div class="col-md-3">
            <div class="form-group">
                <label asp-for="NewMaintenance.Date" class="control-label"></label>
                <input asp-for="NewMaintenance.Date" class="form-control" />
                <span asp-validation-for="NewMaintenance.Date" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-9">
            <div class="form-group">
                <label asp-for="NewMaintenance.Description" class="control-label"></label>
                <input asp-for="NewMaintenance.Description" class="form-control" />
                <span asp-validation-for="NewMaintenance.Description" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-3">
            <div class="form-group">
                <label asp-for="NewMaintenance.Completed" class="control-label"></label>
                <select asp-for="NewMaintenance.Completed" class="form-control" onchange="toggleCompleted()">
                    <option value="false" selected="true">Scheduled</option>
                    <option value="true">Completed</option>
                </select>
                <span asp-validation-for="NewMaintenance.Completed" class="text-danger"></span>
            </div>
            @* <div class="form-check">
                <input class="form-check-input" type="checkbox" asp-for="NewMaintenance.Completed">
                <label class="form-check-label" asp-for="NewMaintenance.Completed">
                </label>
                @Html.CheckBoxFor(model => model.NewMaintenance.Completed, new {@class="form-check-input align-middle"})
                <label asp-for="NewMaintenance.Completed" class="form-check-label"></label>
            </div>*@
        </div>
        <div class="col-md-3" id="divRecurring">
            <div class="form-group">
                <label asp-for="NewMaintIsRecurring" class="control-label"></label>
                <select asp-for="NewMaintIsRecurring" class="form-control" onchange="toggleRecurrence()">
                    <option value="false" selected="true">One-time</option>
                    <option value="true">Recurring</option>
                </select>
                <span asp-validation-for="NewMaintIsRecurring" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-3" id="divRecurringDays" style="display:none">
            <div class="form-group">
                <div class="form-group">
                    <label asp-for="NewMaintRecurrenceFrequency" class="control-label"></label>
                    <input asp-for="NewMaintRecurrenceFrequency" class="form-control" min="1" max="10000" />
                    <span asp-validation-for="NewMaintRecurrenceFrequency" class="text-danger"></span>
                </div>
            </div>
        </div>
        <div class="col-md-3" id="divNumOccurences" style="display:none">
            <div class="form-group">
                <div class="form-group">
                    <label asp-for="NewMaintRecurrenceDuration" class="control-label"></label>
                    <input asp-for="NewMaintRecurrenceDuration" class="form-control" min="1" max="100" />
                    <span asp-validation-for="NewMaintRecurrenceDuration" class="text-danger"></span>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="form-group">
                <input id="btnNewMaintenance" type="submit" value="Schedule Maintenance" class="btn btn-success mt-3 mb-3" />
            </div>
        </div>
    </div>
    @*<div asp-validation-summary="All" class="text-danger mt-1"></div>*@
</form>
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">
        @Model.ErrorMessage
    </div>
}
@if (Model.ScheduledMaintenances.Count > 0)
{
    <h4>Scheduled Maintenance</h4>
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th scope="col">@Html.DisplayNameFor(model => model.ScheduledMaintenances[0].Date)</th>
                    <th scope="col">@Html.DisplayNameFor(model => model.ScheduledMaintenances[0].Description)</th>
                    <th scope="col">@Html.DisplayNameFor(model => model.ScheduledMaintenances[0].Completed)</th>
                    <th scope="col"></th>
                    <th scope="col"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var maint in Model.ScheduledMaintenances)
                {
                    <tr @(maint.Date <= DateOnly.FromDateTime(DateTime.Now) ? "class=table-danger" : "")>
                        <th scope="row">@maint.Date</th>
                        <td>@maint.Description</td>
                        <td>@(maint.Completed ? "Completed" : (maint.Date <= DateOnly.FromDateTime(DateTime.Now) ? "Overdue" : "Scheduled"))</td>
                        <td><a asp-page="./MaintEdit" asp-route-id="@maint.Id">Edit</a></td>
                        <td>
                             
                            <a asp-page="./MaintDelete" asp-route-id="@maint.Id">Delete</a>
                        </td>
                    </tr>
                }

            </tbody>
        </table>
    </div>
}
@if (Model.CompletedMaintenances.Count > 0)
{
    <h4>Completed Maintenance</h4>
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th scope="col">@Html.DisplayNameFor(model => model.CompletedMaintenances[0].Date)</th>
                    <th scope="col">@Html.DisplayNameFor(model => model.CompletedMaintenances[0].Description)</th>
                    <th scope="col">@Html.DisplayNameFor(model => model.CompletedMaintenances[0].Completed)</th>
                    <th scope="col"></th>
                    <th scope="col"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var maint in Model.CompletedMaintenances)
                {
                    <tr class="table-success">
                        <th scope="row">@maint.Date</th>
                        <td>@maint.Description</td>
                        <td>Completed</td>
                 @*       <td>
                            <form method="post" asp-page-handler="togglecomplete">
                                <input type="hidden" name="id" asp-for="@maint.Id" />
                                <input type="submit" value="Uncomplete" class="btn btn-primary btn-sm" />
                            </form>
                        </td>*@
                        <td><a asp-page="./MaintEdit" asp-route-id="@maint.Id">Edit</a></td>
                        <td>
                            <a asp-page="./MaintDelete" asp-route-id="@maint.Id" >Delete</a>
                        </td>
                    </tr>
                }

            </tbody>
        </table>
    </div>
}
@if (Model.ScheduledMaintenances.Count == 0 && Model.CompletedMaintenances.Count == 0)
{
    <div class="col">
        <div class="alert alert-warning" role="alert">
            Maintenance log is empty. Log or schedule maintenance to see the maintenance log for this item.
        </div>
    </div>
}
<script type="text/javascript">
    function toggleCompleted() {
        var value = $("#NewMaintenance_Completed").val();
        if (value == "true"){
            $("#divRecurring").hide();
            $("#divRecurringDays").hide();
            $("#divNumOccurences").hide();  
            $("#NewMaintIsRecurring").val("false");
            $("#btnNewMaintenance").val("Log Maintenance");
        }
        else {
            $("#divRecurring").show();
            //$("#divRecurringDays").show();
            //$("#divNumOccurences").show();
            $("#btnNewMaintenance").val("Schedule Maintenance");
        }
        toggleRecurrence();
    }
    function toggleRecurrence() {
        var value = $("#NewMaintIsRecurring").val();
        if (value == "true") {
            $("#divRecurringDays").show();
            $("#divNumOccurences").show();

        }
        else {
            $("#divRecurringDays").hide();
            $("#divNumOccurences").hide();

        }
    }
</script>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
