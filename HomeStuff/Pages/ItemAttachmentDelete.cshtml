@page
@model HomeStuff.Pages.ItemAttachmentDeleteModel
@{
    ViewData["Title"] = "Delete Attachment";
}

<h1>Delete @Html.DisplayFor(model => model.Name)?</h1>
<hr />
<p>Are you sure you want to delete this attachment?</p>
<div>

    <form method="post">
        <input type="hidden" asp-for="ItemId" />
        <input type="hidden" asp-for="Name" />
        <input type="submit" value="Delete" class="btn btn-danger btn-lg" />
        <a class="btn btn-primary btn-lg" asp-page="./Item" asp-route-id="@Model.ItemId">Cancel</a>
    </form>
</div>
