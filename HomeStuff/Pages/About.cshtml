@page
@model HomeStuff.Pages.AboutModel
@{
    ViewData["Title"] = "About Homestuff";
}

<h1>About Homestuff</h1>
<hr />
<dl class="row">
    <dt class="col-sm-2">
        Assembly Version
    </dt>
    <dd class="col-sm-10">
        @ThisAssembly.AssemblyVersion
    </dd>
</dl>
<dl class="row">
    <dt class="col-sm-2">
        Assembly File Version
    </dt>
    <dd class="col-sm-10">
        @ThisAssembly.AssemblyFileVersion
    </dd>
</dl>
<dl class="row">
    <dt class="col-sm-2">
        Assembly Informational Version
    </dt>
    <dd class="col-sm-10">
        @ThisAssembly.AssemblyInformationalVersion
    </dd>
</dl>

<dl class="row">
    <dt class="col-sm-2">
        Git Commit Date (UTC)
    </dt>
    <dd class="col-sm-10">
        @ThisAssembly.GitCommitDate
    </dd>
</dl>
<dl class="row">
    <dt class="col-sm-2">
        Git Commit Id
    </dt>
    <dd class="col-sm-10">
        @ThisAssembly.GitCommitId
    </dd>
</dl>
