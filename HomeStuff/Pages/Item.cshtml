<dl class="row">
    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.Item.Status)
    </dt>
    <dd class="col-sm-10">
        <span class="@(Model.Item.Status == Models.Item.ItemStatus.Missing ? "text-danger" : "text-dark")">
        @Html.DisplayFor(model => model.Item.Status)
        </span>
    </dd>
</dl>
<dl class="row">
    <dt class="col-sm-2">
        <i>Last Modified</i>
    </dt>
    <dd class="col-sm-10">
        <i>@Model.Item.LastModifiedUtc.ToLocalTime().ToString()</i>
    </dd>
</dl>

<h2>Attachments</h2>

@if (Model.Attachments.Count > 0)
{
    <ul class="list-group">
        @foreach (var attachment in Model.Attachments)
        {
            <li class="list-group-item list-group-item-secondary">
                <div class="row">
                    <div class="col position-relative">
              
                        <a href="@attachment.Url" class="stretched-link ">@attachment.Name [@attachment.Size]</a>
                  
                    </div>
                    <div class="col-auto float-end">
                        <a href="@attachment.DeleteUrl" class="btn btn-sm btn-danger">Delete</a>
                    </div>
                </div>
            </li>
        }
    </ul>
}
else
{
    <div class="alert alert-secondary">
        No attachments
    </div>
}
<form enctype="multipart/form-data" method="post">
    <div class="mb-3">
        <dl>
            <dt>
                <label asp-for="AttachmentFile" class="form-label">Upload an attachment (photo, manual, receipt, etc.). First image (alphabetically) will be used as item photo. </label>
            </dt>
            <dd>
                <div class="input-group">
                    <input asp-for="AttachmentFile" type="file" class="form-control">
                    <div class="input-group-append">
                        <input class="btn btn-primary" type="submit" value="Upload" />
                    </div>

                </div>
            </dd>
        </dl>
        <span asp-validation-for="AttachmentFile" class="text-danger"></span>
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">
                @Model.ErrorMessage
            </div>
        }
    </div>
</form>


@if (Model.NeighborItems != null)
{
    <br/>
    <hr/>
    <h2>@Model.Location.Name</h2>

    <div class="alert alert-secondary">
        <h4>All items in this sub-location (total value: <b>@Html.DisplayFor(model => model.TotalSublocationValue))</h4>
        <ul class="list-group list-group-flush">
            @foreach (var item in Model.NeighborItems!)
            {
                <li class="list-group-item list-group-item-secondary">
                    @if (item.Id == Model.Item.Id)
                    {
                        @("This item: " + item.Name)
                    }
                    else
                    {
                        <a asp-page="item" asp-route-id="@item.Id">@item.Name</a>
                    }
                </li>
            }
        </ul>
    </div>
}