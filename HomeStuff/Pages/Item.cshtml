@page
@model HomeStuff.Pages.ItemModel
@{

}
<h1>@Html.DisplayFor(model => model.Item.Name)</h1>


<hr />
<div class="row">
    <div class="col">
        <div class="btn-group mb-3" role="toolbar" aria-label="Item navigation">
            <a href="#" class="btn btn-primary active" aria-current="page">Details</a>
            <a asp-page="./ItemEdit" asp-route-id="@Model.Item?.Id" class="btn btn-primary">Edit</a>
            <a asp-page="./Maintenance" asp-route-itemid="@Model.Item?.Id" class="btn btn-primary">Maintenance</a>
        </div>
    </div>
    <div class="col-auto float-end">
        <a asp-page="./ItemDelete" asp-route-id="@Model.Item?.Id" class="btn btn-danger">Delete</a>
    </div>
</div>


@if (Models.Item.GetAvatarFileName(Model.webHostEnvironment, Model.configuration, Model.Item.Id) != String.Empty)
{
    <dl class="row">
        <dt class="col-sm-2">
            Item Photo
        </dt>
        <dd class="col-sm-10">
            <img src="/itemattachment?itemid=@Model.Item.Id&name=@Models.Item.GetAvatarFileNameUrlEncoded(Model.webHostEnvironment, Model.configuration, Model.Item.Id)"
                     class="img-fluid rounded" style="max-height:400px;" alt="Avatar image for @Model.Item.Name">
        </dd>

    </dl>
}

<dl class="row">
    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.Item.LocationId)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.Location.FullName)
    </dd>
    
</dl>
