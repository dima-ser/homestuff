@page
@model HomeStuff.Pages.ItemModel
@{

}
<h1>@Html.DisplayFor(model => model.Item.Name)</h1>


<hr />
<div class="row">
    <div class="col">
        <div class="btn-group mb-3" role="toolbar" aria-label="Item navigation">
            <a href="#" class="btn btn-primary active" aria-current="page">Details</a>
            <a asp-page="./ItemEdit" asp-route-id="@Model.Item?.Id" class="btn btn-primary">Edit</a>
            <a asp-page="./ItemMaint" asp-route-itemid="@Model.Item?.Id" class="btn btn-primary">Maintenance</a>
            &nbsp;&nbsp;&nbsp;
            <i class="d-block mt-2" title="@Model.Item!.LastModifiedUtc.ToLocalTime()">Last Modified: @Model.Item.LastModifiedUtc.ToLocalTime().ToShortDateString()</i>
        </div>
    </div>
    <div class="col-auto float-end">
        <a asp-page="./ItemDelete" asp-route-id="@Model.Item?.Id" class="btn btn-danger">Delete</a>
    </div>
</div>

<dl class="row">
    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.Item.LocationId)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.LocationName)
    </dd>
</dl>
@if (!String.IsNullOrEmpty(Model.Item!.Description))
{
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Item.Description)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Item.Description)
        </dd>
    </dl>
}
@if (!String.IsNullOrEmpty(Model.Item.Manufacturer))
{
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Item.Manufacturer)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Item.Manufacturer)
        </dd>
    </dl>
}
@if (!String.IsNullOrEmpty(Model.Item.ModelNumber))
{
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Item.ModelNumber)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Item.ModelNumber)
        </dd>
    </dl>
}
@if (!String.IsNullOrEmpty(Model.Item.SerialNumber))
{
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Item.SerialNumber)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Item.SerialNumber)
        </dd>
    </dl>
}
@if (Model.Item.PurchaseDate != null)
{
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Item.PurchaseDate)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Item.PurchaseDate)
        </dd>
    </dl>
}
@if (!String.IsNullOrEmpty(Model.Item.Vendor))
{
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Item.Vendor)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Item.Vendor)
        </dd>
    </dl>
}
@if (Model.Item.PurchasePrice != null)
{
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Item.PurchasePrice)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Item.PurchasePrice)
        </dd>
    </dl>
}
@if (!String.IsNullOrEmpty(Model.Item.SKU))
{
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Item.SKU)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Item.SKU)
        </dd>
    </dl>
}
<h2>Attachments</h2>

@if (Model.Attachments.Count > 0)
{
    <ul class="list-group">
        @foreach (var attachment in Model.Attachments)
        {
            <li class="list-group-item list-group-item-secondary">
                <div class="row">
                    <div class="col position-relative">
              
                        <a href="@attachment.Url" class="stretched-link ">@attachment.Name [@attachment.Size]</a>
                  
                    </div>
                    <div class="col-auto float-end">
                        <a href="@attachment.DeleteUrl" class="btn btn-sm btn-danger">Delete</a>
                    </div>
                </div>
            </li>
        }
    </ul>
}
else
{
    <div class="alert alert-secondary">
        No attachments
    </div>
}
<form enctype="multipart/form-data" method="post">
    <div class="mb-3">
        <dl>
            <dt>
                <label asp-for="AttachmentFile" class="form-label">Upload an attachment (photo, manual, receipt, etc.)</label>
            </dt>
            <dd>
                <div class="input-group">
                    <input asp-for="AttachmentFile" type="file" class="form-control">
                    <div class="input-group-append">
                        <input class="btn btn-primary" type="submit" value="Upload" />
                    </div>

                </div>
            </dd>
        </dl>
        <span asp-validation-for="AttachmentFile" class="text-danger"></span>
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">
                @Model.ErrorMessage
            </div>
        }
    </div>
</form>


