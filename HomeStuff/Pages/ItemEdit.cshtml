@page
@model HomeStuff.Pages.ItemEditModel

@{
    
}

<h1>@Html.DisplayFor(model => model.Item.Name)</h1>
<hr />
<div class="row">
    <div class="col">
        <div class="btn-group mb-3" role="toolbar" aria-label="Item navigation">
            <a asp-page="./Item" asp-route-id="@Model.Item?.Id" class="btn btn-primary">Details</a>
            <a href="#" class="btn btn-primary active" aria-current="page">Edit</a>
            <a asp-page="./ItemMaint" asp-route-itemid="@Model.Item?.Id" class="btn btn-primary">Maintenance</a>
        </div>
    </div>
    <div class="col-auto float-end">
        <a asp-page="./ItemDelete" asp-route-id="@Model.Item?.Id" class="btn btn-danger">Delete</a>
    </div>
</div>
<form method="post">
    <input type="hidden" asp-for="Item.Id" />
    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                <label asp-for="Item.Name" class="control-label"></label>
                <input asp-for="Item.Name" class="form-control" />
                <span asp-validation-for="Item.Name" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                <label asp-for="Item.LocationId" class="control-label"></label>
                <select asp-for="Item.LocationId" asp-items="Model.Locations" class="form-control"></select>
                <span asp-validation-for="Item.LocationId" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="form-group">
                <label asp-for="Item.Description" class="control-label"></label>
                <textarea asp-for="Item.Description" class="form-control"></textarea>
                <span asp-validation-for="Item.Description" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-4">
            <div class="form-group">
                <label asp-for="Item.Manufacturer" class="control-label"></label>
                <input asp-for="Item.Manufacturer" class="form-control" />
                <span asp-validation-for="Item.Manufacturer" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-4">
            <div class="form-group">
                <label asp-for="Item.ModelNumber" class="control-label"></label>
                <input asp-for="Item.ModelNumber" class="form-control" />
                <span asp-validation-for="Item.ModelNumber" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-4">
            <div class="form-group">
                <label asp-for="Item.SerialNumber" class="control-label"></label>
                <input asp-for="Item.SerialNumber" class="form-control" />
                <span asp-validation-for="Item.SerialNumber" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-4">
            <div class="form-group">
                <label asp-for="Item.PurchaseDate" class="control-label"></label>
                <input asp-for="Item.PurchaseDate" class="form-control" />
                <span asp-validation-for="Item.PurchaseDate" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-4">
            <div class="form-group">
                <label asp-for="Item.Vendor" class="control-label"></label>
                <input asp-for="Item.Vendor" class="form-control" />
                <span asp-validation-for="Item.Vendor" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-4">
            <div class="form-group">
                <label asp-for="Item.PurchasePrice" class="control-label"></label>
                <input asp-for="Item.PurchasePrice" class="form-control" />
                <span asp-validation-for="Item.PurchasePrice" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-4">
            <div class="form-group">
                <label asp-for="Item.SKU" class="control-label"></label>
                <input asp-for="Item.SKU" class="form-control" />
                <span asp-validation-for="Item.SKU" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-success btn-lg mt-3" />
            </div>
        </div>
    </div>
    <div asp-validation-summary="All" class="text-danger"></div>
</form>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
