@page
@model HomeStuff.Pages.SetNewModel

@{
    ViewData["Title"] = "Add Set";
}

<h1>@ViewData["Title"]</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="ItemSet.Name" class="control-label"></label>
                <input asp-for="ItemSet.Name" class="form-control" />
                <span asp-validation-for="ItemSet.Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Add" class="btn btn-success btn-lg mt-3" />
            </div>
        </form>
    </div>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
