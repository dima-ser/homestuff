@page
@model HomeStuff.Pages.MaintEditModel

@{
    ViewData["Title"] = "Edit Maintenance";
}

<h1>@ViewData["Title"]</h1>

<h4>For @Model.ItemName</h4>
<hr />
<form method="post">
    <div class="row">
        <div class="col-md-6">

            <input type="hidden" asp-for="Maintenance.Id" />
            <input type="hidden" asp-for="Maintenance.ItemId" />
            <div class="form-group">
                <label asp-for="Maintenance.Date" class="control-label"></label>
                <input asp-for="Maintenance.Date" class="form-control" />
                <span asp-validation-for="Maintenance.Date" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                <label asp-for="Maintenance.Completed" class="control-label"></label>
                <select asp-for="Maintenance.Completed" class="form-control">
                    <option value="false" selected="true">Scheduled</option>
                    <option value="true">Completed</option>
                </select>
                <span asp-validation-for="Maintenance.Completed" class="text-danger"></span>
            </div>


        </div>
    </div>
    <div class="row">
        <div class="col">
            <div class="form-group">
                <label asp-for="Maintenance.Description" class="control-label"></label>
                <input asp-for="Maintenance.Description" class="form-control" />
                <span asp-validation-for="Maintenance.Description" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="form-group mt-2">
        <input type="submit" value="Save" class="btn btn-success btn-lg" />
        <a class="btn btn-primary btn-lg" asp-page="./Maintenance" asp-route-itemid="@Model.Maintenance.ItemId">Cancel</a>
    </div>
    <div asp-validation-summary="All" class="text-danger"></div>
</form>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
