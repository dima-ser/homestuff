@page
@model HomeStuff.Pages.SetsModel

@{
    ViewData["Title"] = "Sets";
}

<h1>Sets</h1>
<p>A set represents a physical or logical collection of items. Can be used to group items together that may have been purchased individually but need to be tracked together. </p>
<p>
    <a class="btn btn-success" asp-page="SetNew">Add New Set</a>
</p>
<table class="table table-hover">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ItemSet[0].Name)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.ItemSet) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                    <a class="btn btn-primary" asp-page="./SetEdit" asp-route-id="@item.Id">Edit</a>
                    <a class="btn btn-danger" asp-page="./SetDelete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
