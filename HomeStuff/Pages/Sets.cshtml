@page
@model HomeStuff.Pages.SetsModel

@{
    ViewData["Title"] = "Sets";
}

<h1>Sets</h1>
<p>A set represents a group of items that are kept together (e.g., computer where each component is an individual item, a plant/pot combo, etc.) </p>
<p>
    <a class="btn btn-success" asp-page="SetNew">Add New Set</a>
</p>
<table class="table table-hover">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ItemSets[0].Name)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @for (int i = 0; i < Model.ItemSets.Count; i++)
        {
        <tr>
            <td>
                    @Html.DisplayFor(modelItem => Model.ItemSets[i].Name)
            </td>
            <td>
                    <a class="btn btn-primary" asp-page="./SetEdit" asp-route-id="@Model.ItemSets[i].Id">Edit</a>
                    @if (!Model.HasItems[i])
                    {
                        <a class="btn btn-danger" asp-page="./SetDelete" asp-route-id="@Model.ItemSets[i].Id">Delete</a>
                    }

            </td>
        </tr>
}
    </tbody>
</table>
