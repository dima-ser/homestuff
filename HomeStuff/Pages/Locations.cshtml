@page
@model HomeStuff.Pages.LocationsModel

@{
    ViewData["Title"] = "Locations";
}

<h1>Locations</h1>

<p>
    <a class="btn btn-primary" asp-page="LocationNew">Add New Location</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Location[0].Name)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Location) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                <a asp-page="./LocationEdit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./LocationDelete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
