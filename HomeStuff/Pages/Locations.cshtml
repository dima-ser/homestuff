@page
@model HomeStuff.Pages.LocationsModel

@{
    ViewData["Title"] = "Locations";
}

<h1>Locations</h1>
<p>A location represents a physical location where item is located (e.g., bedroom, garage, etc.)</p>
<p>
    <a class="btn btn-success" asp-page="LocationNew">Add New Location</a>
</p>
<table class="table table-hover">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Location[0].Name)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Location) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                <a class="btn btn-primary" asp-page="./LocationEdit" asp-route-id="@item.Id">Edit</a> 
                <a class="btn btn-danger"  asp-page="./LocationDelete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
