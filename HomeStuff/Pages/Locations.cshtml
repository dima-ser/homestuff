@page
@model HomeStuff.Pages.LocationsModel

@{
    ViewData["Title"] = "Locations";
}

<h1>Locations</h1>
<hr />
<p>Represents a physical location where items can be stored. Can be nested up to 2 levels.</p>
<p>
    <a class="btn btn-success" asp-page="LocationNew">Add New Location</a>
</p>
<table class="table table-hover">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.RootLocations[0].Name)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @for (int i = 0; i < Model.RootLocations.Count; i++)
        {
            <tr>
                <td>
                    <a asp-page="./Items" asp-route-l="@Model.RootLocations[i].Id">@Html.DisplayFor(modelItem => Model.RootLocations[i].Name) </a>
                </td>
                <td>
                    <a class="btn btn-primary" asp-page="./LocationEdit" asp-route-id="@Model.RootLocations[i].Id">Edit</a>
                    @if (Model.Sublocations != null && Model.Sublocations[i].Count == 0)
                    {
                        <a class="btn btn-danger" asp-page="./LocationDelete" asp-route-id="@Model.RootLocations[i].Id">Delete</a>
                    }
                </td>
            </tr>
            @if (Model.Sublocations != null && Model.Sublocations[i] != null)
            {
                foreach (var sublocation in Model.Sublocations[i])
                {
                    <tr>
                        <td>
                            &nbsp;&nbsp;&nbsp;&nbsp;<a asp-page="./Items" asp-route-l="@sublocation.Id">@Html.DisplayFor(modelItem => sublocation.Name)</a>
                        </td>
                        <td>
                            <a class="btn btn-primary" asp-page="./LocationEdit" asp-route-id="@sublocation.Id">Edit</a>
                            <a class="btn btn-danger" asp-page="./LocationDelete" asp-route-id="@sublocation.Id">Delete</a>
                        </td>
                    </tr>
                }
            }
        }
    </tbody>
</table>
