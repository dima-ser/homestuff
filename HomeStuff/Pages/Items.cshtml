@page
@model ItemsModel
@{
    ViewData["Title"] = "Items";
}
<h1>@ViewData["Title"]</h1>
<hr />
<form>
    <div class="row g-1 gy-1 mb-3">
        <div class="col-sm">
            <input class="form-control" type="search" placeholder="Keyword(s)" asp-for="q">
        </div>
        <div class="col-sm">
            <select class="form-control" asp-for="l" asp-items="Model.Locations">
                <option value="">All Locations</option>
            </select>
        </div>
        <div class="col-sm input-group">
            <select class="form-control" asp-for="s" asp-items="Model.ItemStatuses">
                <option value="">Any Status</option>
            </select>
            <button class="btn btn-primary" type="submit">Search</button>
        </div>
    </div>
</form>
@if (Model.Count > ItemsModel.PAGE_SIZE)
{
    <div class="row">
        <div class="col">
            <nav aria-label="Page">
                <ul class="pagination">
                    @for (var i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a asp-page="/Items" asp-route-currentpage="@i" asp-route-q="@Model.q" asp-route-l="@Model.l" asp-route-minprice="@Model.MinPrice" class="page-link">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    </div>
}
<div class="row">
    @if ((Model.q != null || Model.l != null) && Model.Items.Count==0)
    {
        <div class="col">
            <div class="alert alert-warning" role="alert">
                No items match search criteria
            </div>
        </div>
    }
    else if (Model.Items.Count == 0)
    {
        <div class="col">
            <div class="alert alert-warning" role="alert">
                No items in the database. Add or import items using the menu.
            </div>
        </div>
    }
    @foreach (var item in Model.Items)
    {
        <div class="col-lg-4 col-md-6 col-sm-6 mb-2">
            <div class="card h-100 card-hover">
                <h5 class="card-header bg-primary text-light text-truncate">@item.Name</h5>
                <div class="card-body border-primary">
                    @if (Models.Item.GetAvatarFileName(Model.WebHostEnvironment, Model.Configuration, item.Id) != String.Empty)
                    {
                        <img src="/itemattachment?itemid=@item.Id&name=@Models.Item.GetAvatarFileNameUrlEncoded(Model.WebHostEnvironment, Model.Configuration, item.Id)"
                             class="float-start avatar-image rounded" alt="Avatar image for @item.Name">
                    }
                    <p class="card-text card-description" >
                        @item.Description
                    </p>
                    <span class="badge bg-dark align-bottom">@item.Location!.FullName</span>
                    @if (item.PurchasePrice != null)
                    {
                        <span class="badge bg-success align-bottom">@Html.DisplayFor(model => item.PurchasePrice)</span>
                    }
                    @if (item.Status == Models.Item.ItemStatus.Missing)
                    {
                        <span class="badge bg-danger align-bottom">@Html.DisplayFor(model => item.Status)</span>
                    }
                    @if (item.Status == Models.Item.ItemStatus.Gone)
                    {
                        <span class="badge bg-warning align-bottom">@Html.DisplayFor(model => item.Status)</span>
                    }
                    <a asp-page="./Item" asp-route-id="@item.Id" class="stretched-link"></a>
                </div> 
            </div>
        </div>
    }
</div>
@if (Model.Count > ItemsModel.PAGE_SIZE)
{
    <div class="row">
        <div class="col">
            <nav aria-label="Page">
                <ul class="pagination">
                    @for (var i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a asp-page="/Items" asp-route-currentpage="@i" asp-route-q="@Model.q" asp-route-l="@Model.l" asp-route-minprice="@Model.MinPrice" class="page-link">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    </div>
}