@page
@model HomeStuff.Pages.MaintDeleteModel

@{
    ViewData["Title"] = "Delete Maintenance";
}

<h1>Delete Maintenance?</h1>

<p>Are you sure you want to delete this maintenance?</p>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Item)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Item.Name)
        </dd>
        <dt class="col-sm-2">
            Maintenance Description
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Maintenance.Description)
        </dd>
        <dt class="col-sm-2">
            Maintenance Date
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Maintenance.Date)
        </dd>
        <dt class="col-sm-2">
            Maintenance Status
        </dt>
        <dd class="col-sm-10">
            @(Model.Maintenance.Completed ? "Completed" : (Model.Maintenance.Date <= DateOnly.FromDateTime(DateTime.Now) ? "Overdue" : "Scheduled"))
        </dd>
    </dl>
    
    <form method="post">
        <input type="hidden" asp-for="Maintenance.Id" />
        <input type="submit" value="Delete" class="btn btn-danger btn-lg" /> 
        <a class="btn btn-primary btn-lg" asp-page="./Maintenance" asp-route-itemid="@Model.Maintenance.ItemId">Cancel</a>
    </form>
</div>
